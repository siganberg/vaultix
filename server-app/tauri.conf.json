{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultix Server",
  "version": "0.3.1",
  "identifier": "app.vaultix.server",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "app"],
    "publisher": "Vaultix",
    "category": "Utility",
    "shortDescription": "Run a Vaultix drive on this computer",
    "longDescription": "Hosts your own Vaultix cloud drive on this computer. No Docker or terminal needed.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    },
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1"] }
    }
  }
}
