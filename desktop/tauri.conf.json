{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultix",
  "version": "0.3.1",
  "identifier": "app.vaultix.sync",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "Vaultix",
    "category": "Utility",
    "shortDescription": "Sync a folder with your Vaultix drive",
    "longDescription": "Keeps a folder on this computer in sync with your self-hosted Vaultix drive.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    },
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1"] }
    }
  }
}
